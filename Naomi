
#include <iostream>
using namespace std;

int main()
{
    int number;

    // Ask the user to enter a number
    cout << "Enter a number: ";
    cin >> number;

    // Check whether the number is divisible by 2
    if (number % 2 == 0)
    {
        cout << number << " is an Even number." << endl;
    }
    else
    {
        cout << number << " is an Odd number." << endl;
    }

    return 0;
}
